{
  "plan": "silver",
  "version": "17.0.0-ee",
  "settings": {
    "admin_mode": "true",
    "session_expire_delay": 10080,
    "session_expire_from_init": true,
    "notify_on_unknown_sign_in": true,
    "signup_enabled": false,
    "require_admin_approval_after_user_signup": true,
    "email_confirmation_setting": "soft",
    "deactivate_dormant_users": true,
    "deactivate_dormant_users_period": 30,
    "can_create_group": false,
    "allow_project_creation_for_guest_and_below": false,
    "default_projects_limit": 0,
    "default_project_visibility": "private",
    "default_group_visibility": "private",
    "default_snippet_visibility": "private",
    "restricted_visibility_levels": [],
    "require_personal_access_token_expiry": true,
    "service_access_tokens_expiration_enforced": true,
    "max_personal_access_token_lifetime": null,
    "user_oauth_applications": false,
    "disable_admin_oauth_scopes": true,
    "allow_local_requests_from_web_hooks_and_services": false,
    "allow_local_requests_from_system_hooks": false,
    "dns_rebinding_protection_enabled": true,
    "silent_admin_exports_enabled": false,
    "password_authentication_enabled_for_web": false,
    "password_authentication_enabled_for_git": false,
    "require_two_factor_authentication": true,
    "two_factor_grace_period": false,
    "require_admin_two_factor_authentication": true,
    "unchecked_secret_field": "must-not-appear-in-output"
  }
}
